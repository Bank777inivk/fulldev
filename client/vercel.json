{
    "version": 2,
    "crons": [
        {
            "path": "/api/cron/remind-verification",
            "schedule": "0 0 * * *"
        }
    ],
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/.*",
            "dest": "/index.html"
        }
    ]
}
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if the user has the admin role
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Global Admin Rule: Admins can do anything
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow get, update: if request.auth != null && request.auth.uid == userId;
    }

    // Individual collection rules for clients
    // (Existing clients still need their specific rules for privacy)
    
    // Transactions
    match /transactions/{transactionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
    }

    // KYC Records
    match /kyc/{kycId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Card Requests
    match /card_requests/{requestId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Active Cards
    match /cards/{cardId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Wallets
    match /wallets/{walletId} {
       allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Loans
    match /loans/{loanId} {
       allow read: if request.auth != null && resource.data.userId == request.auth.uid;
       allow create: if request.auth != null;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Loan Leads (Public Leads)
    match /loan_leads/{leadId} {
      allow create: if true;
    }

    // Contact Messages (Public)
    match /contact_messages/{messageId} {
      allow create: if true;
    }

    // Support Tickets
    match /support_tickets/{ticketId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      
      match /messages/{messageId} {
        allow read, create: if request.auth != null && 
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid;
      }
    }
  }
}
